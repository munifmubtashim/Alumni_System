{
  "name": "alumni-system",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/backend/src/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=packages/backend/src/api",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "dev": "npm run dev:api & npm run dev:frontend",
    "test:backend": "npm test --workspace=packages/backend",
    "typecheck:backend": "npm run typecheck --workspace=packages/backend"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^10.0.5"
  }
}
